			)
			(justify left top)
		)
		(uuid "147bcb59-8c86-4c15-b416-817dd24fecc0")
	)
	(text_box "The transistor isolates MCU from the + HV supply, since EN_X pins are pulled up to VCC (HV) with 200k internally."
		(exclude_from_sim no)
		(at 139.7 52.5272 0)
