		(uuid "4204e3f4-4b5b-457b-a1ab-db9201ceead1")
	)
	(text_box "PULSE_IN delivers square pulses 0-3.3V with the maximum frequency up to 10 MHz. It should be driven low if the PULSE_IN output is in high-Z state."
		(exclude_from_sim no)
		(at 143.51 33.4772 0)
		(size -46.99 12.7)
