		(uuid "9fb75811-e968-40a9-9b1c-12fa1bcc5b05")
	)
	(text_box "Pulser IXDD604D2TR has a max source resistance of 2.5 Ohm with typical rise time of 9 ns and fall time of 8 ns. Maximum source current is 9 A. Power supply current <1 uA from VCC."
		(exclude_from_sim no)
		(at 226.06 32.2072 0)
		(size -55.88 12.7)
